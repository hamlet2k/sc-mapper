<ActionMaps>
 <ActionProfiles version="1" optionsVersion="2" rebindVersion="2" profileName="default">
  <!-- e2e fixture: a friend with a VKB Gladiator on js1 and a Warthog stick on js2, who imports the shared stick -->
  <options type="keyboard" instance="1" Product="Keyboard  {6F1D2B61-D5A0-11CF-BFC7-444553540000}"/>
  <options type="joystick" instance="1" Product=" VKBsim Gladiator EVO R    {0200231D-0000-0000-0000-504944564944}">
   <flight_move_pitch invert="1"/>
  </options>
  <options type="joystick" instance="2" Product=" Joystick - HOTAS Warthog  {0402044F-0000-0000-0000-504944564944}">
   <flight_move_yaw exponent="2"/>
  </options>
  <modifiers />
  <actionmap name="spaceship_movement">
   <action name="v_pitch">
    <rebind input="js1_y"/>
   </action>
   <action name="v_roll">
    <rebind input="js1_x"/>
   </action>
   <action name="v_yaw">
    <rebind input="js1_rotz"/>
   </action>
   <action name="v_space_brake">
    <rebind input="kb1_x"/>
    <rebind input="js2_button2"/>
   </action>
   <action name="v_toggle_landing_system">
    <rebind input="kb1_n"/>
    <rebind input="js2_button19"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_weapons">
   <action name="v_weapon_gimbals_state_toggle">
    <rebind input="kb1_g"/>
    <rebind input="js2_button16"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_defensive">
   <action name="v_weapon_countermeasure_decoy_launch">
    <rebind input="kb1_h"/>
    <rebind input="js1_button3"/>
   </action>
  </actionmap>
 </ActionProfiles>
</ActionMaps>
